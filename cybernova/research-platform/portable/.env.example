CYBERNOVA_MODEL=cybernova-security:30b
CYBERNOVA_OLLAMA_URL=http://ollama:11434/api/chat
CYBERNOVA_LLM_BASE_URL=
CYBERNOVA_LLM_API_KEY_FILE=

